---
import '@fontsource-variable/archivo/wdth.css';
import { STRINGS, langBase, type Lang } from '../lib/i18n';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
}
const { title, lang = 'ja', description = STRINGS[lang].description } = Astro.props;
const t = STRINGS[lang];
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const root = langBase(base, lang);

// 言語切替リンク: 現在のパスの対応ページへ（ja ⇔ en）
// 注意: サブパス配信時、トップ等では pathname が末尾スラッシュなし（= base と完全一致しない）になるため両形を処理する
const pathname = Astro.url.pathname;
const baseNoSlash = base.slice(0, -1);
let rel: string;
if (pathname.startsWith(base)) {
  rel = pathname.slice(base.length);
} else if (pathname === baseNoSlash) {
  rel = '';
} else if (baseNoSlash && pathname.startsWith(`${baseNoSlash}/`)) {
  rel = pathname.slice(baseNoSlash.length + 1);
} else {
  rel = pathname.replace(/^\//, '');
}
const altHref = lang === 'en' ? base + rel.replace(/^en\/?/, '') : `${base}en/${rel}`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <!-- モバイルのブラウザ UI を地色に合わせる（既定の白いツールバーが黒地から浮くのを防ぐ） -->
    <meta name="theme-color" content="#0a0a0d" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a href={root} class="site-logo">
        <span class="logo-mark" aria-hidden="true"></span>
        <span class="logo-text">
          <span class="logo-eyebrow">{t.logoEyebrow}</span>
          <span class="logo-name">{t.logoText}</span>
        </span>
      </a>
      <a class="lang-switch" href={altHref}>{t.langSwitch}</a>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>{t.footerUnofficial}</p>
      <p>
        {t.footerRights1}<a href={t.footerChannelUrl} target="_blank" rel="noopener noreferrer">{t.footerChannelName}</a>{t.footerRights2}
      </p>
      <p>
        {t.footerAccount}: <a href={t.xUrl} target="_blank" rel="noopener noreferrer">{t.xHandle}</a>
      </p>
    </footer>
    <!-- GoatCounter: Cookie を使わないプライバシー配慮のアクセス計測（localhost は自動的にカウント対象外） -->
    <script
      data-goatcounter="https://trailblazer-notes.goatcounter.com/count"
      async
      src="https://gc.zgo.at/count.js"></script>
  </body>
</html>

<style is:global>
  /*
   * 配色の考え方:
   *  - 公式サイトの地色（ニアブラック）とアクセント（シャンパンゴールド #dbbf91）に寄せる。
   *    公式アセットは一切使わず、色と幾何だけで質感を合わせる。
   *  - アクセントは signal（金）ひとつだけ。第二の色は置かない。
   *  - ネタバレ領域（終了後の視聴を推奨・種別ページ）は色ではなく「破線の左罫」で示す。
   *    実線＝進行度の内側 / 破線＝進行度を超える、という一本の規則に統一する。
   */
  :root {
    /* 常時ダーク。宣言しないとスクロールバーやフォーム部品だけ明色のまま残る */
    color-scheme: dark;

    --ink: #0a0a0d;
    --ink-2: #131319;
    --ink-3: #1c1c24;
    --rail: #2b2b35;
    --rail-lit: #46465a;
    --signal: #dbbf91;
    --signal-dim: rgba(219, 191, 145, 0.12);
    /* 路線そのものの線。signal を薄めて「経路」と「現在地」を色で地続きにする */
    --route: rgba(219, 191, 145, 0.26);
    --route-lit: rgba(219, 191, 145, 0.62);
    --paper: #f0f1f3;
    --paper-dim: #a0a4ac;

    --radius: 2px;
    /* 重なりはこの 2 段のみ。段を増やすときは必ずここに定義してから使う */
    --z-ambient: -1;
    --z-sticky: 10;
    /* 面取り: 右辺の角を落とした板。公式 UI の角落としに合わせた幾何で、素材は使わない */
    --cut: 10px;
    --chamfer: polygon(
      0 0,
      calc(100% - var(--cut)) 0,
      100% var(--cut),
      100% calc(100% - var(--cut)),
      calc(100% - var(--cut)) 100%,
      0 100%
    );
    /* 和文は公式と同じ順で系統を揃える。ラテンは自前ホストの Archivo（外部リクエストなし） */
    --body: 'Archivo Variable', '游ゴシック体', YuGothic, 'Yu Gothic Medium', 'Hiragino Sans',
      'Noto Sans JP', sans-serif;
    --display: 'Archivo Variable', '游ゴシック体', YuGothic, 'Hiragino Sans', 'Noto Sans JP',
      sans-serif;
    --measure: 1000px;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--body);
    line-height: 1.75;
    font-variant-numeric: tabular-nums;
    -webkit-font-smoothing: antialiased;
  }
  /*
   * 宙域の気配。画像を使わず、上端のごく淡い光だけで黒地に奥行きを与える。
   * 光はビューポートではなくページ先頭に固定する（absolute + 明示の高さ）。
   * fixed だと画面上端に常に光が乗り、そこへ吸着するバージョン帯の不透明な地色が
   * 帯状の黒い段差として浮いてしまうため。
   */
  body::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 100svh;
    z-index: var(--z-ambient);
    pointer-events: none;
    background: radial-gradient(120% 55% at 50% -12%, rgba(219, 191, 145, 0.08), transparent 62%);
  }
  h1,
  h2,
  h3 {
    text-wrap: balance;
    letter-spacing: 0.01em;
  }
  p {
    text-wrap: pretty;
  }
  /* 日本語を文節単位で折り返す（未対応ブラウザでは既定の折り返しにフォールバック） */
  :root:lang(ja) h1,
  :root:lang(ja) h2,
  :root:lang(ja) h3,
  :root:lang(ja) p {
    word-break: auto-phrase;
  }
  a {
    color: var(--signal);
  }
  :focus-visible {
    outline: 2px solid var(--signal);
    outline-offset: 3px;
    border-radius: 2px;
  }
  main {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 1.75rem 1.25rem 4rem;
  }

  /* 行先表示板の見出し。幅軸を広げたラテンで標識らしい字面を作る */
  .eyebrow {
    font-family: var(--display);
    font-stretch: 125%;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--paper-dim);
  }

  /* セクション見出し: 見出し + 罫線 + 右端の件数 */
  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
    margin: 3.25rem 0 0.5rem;
  }
  .section-head::after {
    content: '';
    flex: 1;
    min-width: 2rem;
    height: 1px;
    background: var(--rail);
    transform: translateY(-0.3em);
  }
  .section-head h2 {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
  .section-head .tally {
    order: 3;
    flex: 0 0 auto;
    font-family: var(--display);
    font-stretch: 112%;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--paper-dim);
  }

  .site-header {
    border-bottom: 1px solid var(--rail);
    padding: 0.9rem 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    max-width: var(--measure);
    margin: 0 auto;
  }
  .site-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-width: 0;
    color: var(--paper);
    text-decoration: none;
  }
  /* 路線図の駅と同じ菱形。サイト内の幾何をひとつに揃える（公式ロゴは使わない） */
  .logo-mark {
    flex: 0 0 auto;
    width: 9px;
    height: 9px;
    background: var(--signal);
    transform: rotate(45deg);
    box-shadow: 0 0 0 4px var(--signal-dim);
  }
  .logo-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.3;
  }
  /* 狭い画面でも言語切替を同じ行に収めるため、ロゴ側を省略記号で畳む */
  .logo-name,
  .logo-eyebrow {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .logo-name {
    font-weight: 700;
    font-size: 0.92rem;
  }
  /* 公式に寄せた配色のぶん、非公式であることは常に見えている必要がある。
     地に対して最も明度差のある金を当て、小さくても埋もれないようにする */
  .logo-eyebrow {
    font-family: var(--display);
    font-stretch: 125%;
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--signal);
  }
  .lang-switch {
    flex: 0 0 auto;
    font-family: var(--display);
    font-stretch: 112%;
    border: 1px solid var(--rail);
    border-radius: var(--radius);
    padding: 0.3rem 0.9rem;
    color: var(--paper-dim);
    font-size: 0.76rem;
    letter-spacing: 0.06em;
    text-decoration: none;
    transition: border-color 0.15s, color 0.15s;
  }
  .lang-switch:hover {
    border-color: var(--signal);
    color: var(--signal);
  }

  .site-footer {
    border-top: 1px solid var(--rail);
    color: var(--paper-dim);
    font-size: 0.78rem;
    line-height: 1.7;
    max-width: var(--measure);
    margin: 0 auto;
    padding: 1.5rem 1.25rem 2.5rem;
  }
  .site-footer p {
    margin: 0.25rem 0;
  }

  h1 {
    font-size: clamp(1.45rem, 3.4vw, 2rem);
    line-height: 1.45;
    margin: 0 0 0.6rem;
  }
  .lead {
    color: var(--paper-dim);
    /* ch はラテン字幅基準で和文だと極端に狭くなるため、em で行長を決める */
    max-width: 52em;
  }
  /* 和文は 1 字 ≒ 1em、英字はその半分弱。同じ 52em だと英語版だけ 1 行が倍近く伸びる */
  :root:lang(en) .lead {
    max-width: 34em;
  }
  .lead strong {
    color: var(--paper);
    font-weight: 600;
  }

  /* 掲示の注記。左罫の実線／破線でどちらの合図かを示す（面取りは右辺のみ＝左罫を欠かさない） */
  .notice {
    border-left: 3px solid var(--signal);
    background: var(--ink-2);
    clip-path: var(--chamfer);
    padding: 0.85rem 1.1rem;
    color: var(--paper-dim);
    font-size: 0.86rem;
  }
  .notice strong {
    color: var(--paper);
    font-weight: 600;
  }

  /*
   * 横向きのノッチ端末で本文が切り欠きに潜らないよう、左右余白の下限を安全域に合わせる。
   * 各要素の padding ショートハンドより後に置いて上書きされないようにする。
   */
  main,
  .site-header,
  .site-footer {
    padding-left: max(1.25rem, env(safe-area-inset-left));
    padding-right: max(1.25rem, env(safe-area-inset-right));
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>
