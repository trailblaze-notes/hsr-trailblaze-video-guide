---
import type { MajorGroup } from '../lib/schema';
import { STRINGS, langBase, type Lang } from '../lib/i18n';

interface Props {
  prev: MajorGroup | null;
  next: MajorGroup | null;
  lang?: Lang;
}
const { prev, next, lang = 'ja' } = Astro.props;
const t = STRINGS[lang];
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const root = langBase(base, lang);
---
<nav class="version-nav">
  {prev ? <a class="step prev" href={`${root}v/${prev.major}/`}>← Ver.{prev.major}.x</a> : <span class="step"></span>}
  <a class="index-link" href={root}>{t.navIndex}</a>
  {next ? <a class="step next" href={`${root}v/${next.major}/`}>Ver.{next.major}.x →</a> : <span class="step"></span>}
</nav>

<style>
  .version-nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.75rem;
    border-top: 1px solid var(--rail);
    border-bottom: 1px solid var(--rail);
    padding: 0.55rem 0;
    margin: 1.25rem 0;
    font-family: var(--display);
    font-stretch: 112%;
    font-size: 0.82rem;
    letter-spacing: 0.03em;
  }
  .step {
    text-decoration: none;
    color: var(--paper-dim);
    transition: color 0.15s;
  }
  .next {
    text-align: right;
  }
  a.step:hover {
    color: var(--signal);
  }
  .index-link {
    color: var(--paper-dim);
    text-decoration: none;
    border: 1px solid var(--rail);
    border-radius: var(--radius);
    padding: 0.15rem 0.75rem;
    transition: border-color 0.15s, color 0.15s;
  }
  .index-link:hover {
    border-color: var(--signal);
    color: var(--signal);
  }
</style>
