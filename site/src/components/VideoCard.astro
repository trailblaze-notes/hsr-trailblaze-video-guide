---
import type { Video } from '../lib/schema';
import { TYPE_LABELS, STRINGS, type Lang } from '../lib/i18n';

interface Props {
  video: Video;
  lang?: Lang;
}
const { video, lang = 'ja' } = Astro.props;
const t = STRINGS[lang];
const watchUrl = `https://www.youtube.com/watch?v=${video.youtubeId}`;
// プライバシー強化モードの公式埋め込みプレイヤー。サムネ・再生とも YouTube 側で完結する
const embedUrl = `https://www.youtube-nocookie.com/embed/${video.youtubeId}`;
// 覆いは同じ文言が 1 ページに何度も並ぶため、読み上げ名に動画名を含めてどれの覆いか分かるようにする
const coverLabel = `${t.thumbHidden}${lang === 'ja' ? '。' : '. '}${t.thumbReveal}: ${video.title}`;
---
<article class="video-card">
  {video.embeddable && (
    <div class="embed">
      {/* 覆いはプレイヤーより前に置く。キーボードで「表示する」を通ってからプレイヤーへ入る順序にする */}
      {video.hideThumbnail && (
        <label class="cover">
          {/* チェックボックスとラベルの入れ子で JS なしに開閉する（id 不要 = 同一ページ重複掲載でも衝突しない） */}
          <input class="reveal" type="checkbox" aria-label={coverLabel} />
          <span class="cover-text" aria-hidden="true">{t.thumbHidden}</span>
          <span class="cover-cta" aria-hidden="true">{t.thumbReveal}</span>
        </label>
      )}
      <iframe
        src={embedUrl}
        title={video.title}
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen></iframe>
    </div>
  )}
  <div class="body">
    <p class="meta">
      <span class="badge">{TYPE_LABELS[lang][video.type]}</span>
      <span class="date">{video.publishedAt}</span>
    </p>
    <h3><a href={watchUrl} target="_blank" rel="noopener noreferrer">{video.title}</a></h3>
    <p class="watch"><a href={watchUrl} target="_blank" rel="noopener noreferrer">{t.watch}</a></p>
  </div>
</article>

<style>
  .video-card {
    display: flex;
    flex-direction: column;
    background: var(--ink-2);
    border: 1px solid var(--rail);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.15s;
  }
  .video-card:hover {
    border-color: var(--rail-lit);
  }
  .embed {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
    border-bottom: 1px solid var(--rail);
  }
  .embed iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  /* サムネイル自体がネタバレになる動画の覆い。押すまでプレイヤーは見えない */
  .cover {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: var(--ink-3);
    cursor: pointer;
    text-align: center;
    padding: 1rem;
  }
  .cover:has(.reveal:checked) {
    display: none;
  }
  /*
   * 覆いが出ている間はプレイヤー自体を隠す。visibility なら Tab の巡回対象からも外れるので、
   * 「表示する」を押す前にプレイヤー内へ入り込めてしまうことがない
   */
  .cover:not(:has(.reveal:checked)) + iframe {
    visibility: hidden;
  }
  .reveal {
    /* 見た目は消すがキーボード操作の対象としては残す */
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .cover:has(.reveal:focus-visible) {
    outline: 2px solid var(--signal);
    outline-offset: -3px;
  }
  .cover-text {
    color: var(--signal);
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1.5;
  }
  .cover-cta {
    border: 1px solid var(--signal);
    border-radius: var(--radius);
    padding: 0.25rem 0.9rem;
    color: var(--signal);
    font-size: 0.78rem;
    transition: background 0.15s;
  }
  .cover:hover .cover-cta {
    background: var(--signal-dim);
  }
  .body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 0.85rem 1rem 1rem;
  }
  .meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    margin: 0;
  }
  .badge {
    font-size: 0.7rem;
    font-weight: 600;
    line-height: 1.6;
    color: var(--paper-dim);
    border: 1px solid var(--rail);
    border-radius: var(--radius);
    padding: 0.02rem 0.45rem;
  }
  .date {
    font-family: var(--display);
    font-stretch: 112%;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--paper-dim);
    white-space: nowrap;
  }
  h3 {
    /* flex:1 で見出し欄を伸ばし、視聴リンクをカード下端に揃える */
    flex: 1;
    margin: 0.5rem 0 0;
    font-size: 0.94rem;
    line-height: 1.55;
  }
  h3 a {
    color: var(--paper);
    text-decoration: none;
  }
  h3 a:hover {
    color: var(--signal);
  }
  .watch {
    margin: 0.7rem 0 0;
    padding-top: 0.6rem;
    border-top: 1px solid var(--rail);
    font-size: 0.78rem;
  }
  .watch a {
    text-decoration: none;
  }
  .watch a:hover {
    text-decoration: underline;
  }
</style>
