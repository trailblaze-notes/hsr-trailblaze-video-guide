---
import Base from '../../layouts/Base.astro';
import VideoCard from '../VideoCard.astro';
import { loadVersions, groupByMajor, type VideoType } from '../../lib/schema';
import { STRINGS, TYPE_LABELS, type Lang } from '../../lib/i18n';

interface Props {
  lang: Lang;
  type: VideoType;
}
const { lang, type } = Astro.props;
const t = STRINGS[lang];
const label = TYPE_LABELS[lang][type];

const byDate = (a: { publishedAt: string }, b: { publishedAt: string }) =>
  a.publishedAt.localeCompare(b.publishedAt);

// メジャーバージョンのトグルのみで区切り、中は公開日順の一気見（種別ページはネタバレ配慮なし）
const groups = groupByMajor(loadVersions(lang), lang)
  .map((group) => ({
    ...group,
    all: group.versions
      .flatMap((version) => version.videos)
      .filter((v) => v.type === type && !v.excludeFromTypePages)
      .sort(byDate),
  }))
  .filter((group) => group.all.length > 0);

const total = groups.reduce((sum, g) => sum + g.all.length, 0);
const countText = (n: number) => (lang === 'ja' ? `${n} 件` : `${n} videos`);
---
<Base title={`${label} | ${t.siteTitle}`} lang={lang}>
  <div class="page-head">
    <p class="eyebrow">{lang === 'ja' ? `全 ${total} 件` : `${total} videos`}{t.typeSub}</p>
    <h1>{label}</h1>
  </div>

  <p class="notice caution-notice">{t.typeNote}</p>

  {
    groups.map((group) => (
      <details class="major-toggle">
        <summary>
          <span class="major-ver">Ver.{group.major}.x</span>
          {group.arc && <span class="major-name">{lang === 'ja' ? `（${group.arc}）` : group.arc}</span>}
          <span class="count">{countText(group.all.length)}</span>
        </summary>
        <div class="major-body">
          <div class="video-list">
            {group.all.map((video) => (
              <VideoCard video={video} lang={lang} />
            ))}
          </div>
        </div>
      </details>
    ))
  }
</Base>

<style>
  .page-head {
    margin: 1.75rem 0 1.25rem;
  }
  .page-head .eyebrow {
    margin: 0 0 0.2rem;
  }
  .page-head h1 {
    margin: 0;
  }
  /* 種別ページは進行度を問わず全件並ぶ = ネタバレを含む。琥珀の合図に統一する */
  .caution-notice {
    border-left-color: var(--caution);
  }

  .major-toggle {
    background: var(--ink-2);
    clip-path: var(--chamfer);
    margin: 0.7rem 0;
  }
  /* 面取りで外側の輪郭が切られるため、フォーカス枠は内側に描く */
  .major-toggle > summary:focus-visible {
    outline-offset: -4px;
  }
  .major-toggle summary {
    cursor: pointer;
    padding: 0.85rem 1rem;
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
    list-style: none;
  }
  .major-toggle summary::-webkit-details-marker {
    display: none;
  }
  .major-toggle summary::after {
    content: '';
    align-self: center;
    flex: 0 0 auto;
    width: 7px;
    height: 7px;
    border-right: 2px solid var(--paper-dim);
    border-bottom: 2px solid var(--paper-dim);
    transform: rotate(225deg) translate(-2px, -2px);
    transition: transform 0.15s;
  }
  .major-toggle:not([open]) summary::after {
    transform: rotate(45deg) translate(-2px, -2px);
  }
  .major-toggle[open] summary {
    border-bottom: 1px solid var(--rail);
  }
  .major-toggle summary:hover .major-name {
    color: var(--signal);
  }
  .major-ver {
    color: var(--signal);
    font-family: var(--display);
    font-stretch: 112%;
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.03em;
  }
  .major-name {
    font-weight: 700;
    transition: color 0.15s;
  }
  .count {
    /* 件数とシェブロンを行の右端へ寄せる */
    margin-left: auto;
    color: var(--paper-dim);
    font-family: var(--display);
    font-stretch: 112%;
    font-size: 0.74rem;
    letter-spacing: 0.04em;
  }
  .major-body {
    padding: 1rem;
  }
  .video-list {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  }
</style>
