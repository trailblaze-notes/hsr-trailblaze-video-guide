---
import Base from '../../layouts/Base.astro';
import VideoCard from '../VideoCard.astro';
import VersionNav from '../VersionNav.astro';
import { VIDEO_TYPES, type MajorGroup } from '../../lib/schema';
import { STRINGS, TYPE_LABELS, type Lang } from '../../lib/i18n';

interface Props {
  lang: Lang;
  group: MajorGroup;
  prev: MajorGroup | null;
  next: MajorGroup | null;
}
const { lang, group, prev, next } = Astro.props;
const t = STRINGS[lang];

const first = group.versions[0];
const last = group.versions[group.versions.length - 1];

// マイナーバージョンごとに、視聴タイミング（before/after）× 種別でグループ化する
const minors = group.versions.map((version) => {
  const sectionsFor = (phase: 'before' | 'after') =>
    VIDEO_TYPES.map((type) => ({
      type,
      label: TYPE_LABELS[lang][type],
      videos: version.videos
        .filter((video) => video.type === type && video.phase === phase)
        .sort((a, b) => a.publishedAt.localeCompare(b.publishedAt)),
    })).filter((section) => section.videos.length > 0);
  return {
    version,
    anchor: `v${version.id.replace('.', '-')}`,
    beforeSections: sectionsFor('before'),
    afterSections: sectionsFor('after'),
    afterCount: version.videos.filter((video) => video.phase === 'after').length,
  };
});

const subLine =
  lang === 'ja' ? `全${group.versions.length}バージョン` : `${group.versions.length} versions`;
const countText = (n: number) => (lang === 'ja' ? `動画 ${n} 件` : `${n} videos`);
const periodText = (v: (typeof group.versions)[number]) =>
  lang === 'ja'
    ? `${v.startDate} 開始${v.endDate ? `（〜 ${v.endDate}）` : '（配信中）'}`
    : `${v.startDate}${v.endDate ? ` – ${v.endDate}` : ' – current'}`;
---
<Base title={`Ver.${group.major}.x${group.arc ? `（${group.arc}）` : ''} | ${t.siteTitle}`} lang={lang}>
  <VersionNav prev={prev} next={next} lang={lang} />

  <div class="page-head">
    <span class="num" aria-hidden="true"><b>{group.major}</b><i>.x</i></span>
    <div class="page-head-text">
      <p class="eyebrow">Ver.{first.id} → Ver.{last.id} ・ {subLine}</p>
      <h1>{group.arc ?? `Ver.${group.major}.x`}</h1>
    </div>
  </div>

  <p class="notice">
    {t.majorNote1}<strong>{t.majorNoteBefore}</strong>{t.majorNoteAnd}<strong>{t.majorNoteAfter}</strong>{t.majorNote2}
  </p>

  <nav class="chip-row" aria-label={t.chipAria}>
    {minors.map(({ version, anchor }) => (
      <a class="chip" href={`#${anchor}`}>Ver.{version.id}</a>
    ))}
  </nav>

  {
    minors.map(({ version, anchor, beforeSections, afterSections, afterCount }) => (
      <details class="minor" id={anchor}>
        <summary>
          <span class="minor-ver">Ver.{version.id}</span>
          <span class="minor-name">{lang === 'ja' ? `「${version.name}」` : version.name}</span>
          <span class="count">{version.videos.length > 0 ? countText(version.videos.length) : t.minorPreparing}</span>
        </summary>
        <div class="minor-body">
          <p class="period">{periodText(version)}</p>
          {version.videos.length === 0 && (
            <p class="empty">
              {t.emptyText}
              <a href={t.footerChannelUrl} target="_blank" rel="noopener noreferrer">{t.emptyLink}</a>
            </p>
          )}
          {beforeSections.map((section) => (
            <section>
              <h3>
                {section.label} <span class="count">{countText(section.videos.length)}</span>
              </h3>
              <div class="video-list">
                {section.videos.map((video) => (
                  <VideoCard video={video} lang={lang} />
                ))}
              </div>
            </section>
          ))}
          {afterCount > 0 && (
            <details class="phase-after">
              <summary>
                <span class="after-label">{t.afterSummary}</span>
                <span class="count">{countText(afterCount)}</span>
              </summary>
              <div class="after-body">
                {afterSections.map((section) => (
                  <section>
                    <h3>
                      {section.label} <span class="count">{countText(section.videos.length)}</span>
                    </h3>
                    <div class="video-list">
                      {section.videos.map((video) => (
                        <VideoCard video={video} lang={lang} />
                      ))}
                    </div>
                  </section>
                ))}
              </div>
            </details>
          )}
        </div>
      </details>
    ))
  }

  <VersionNav prev={prev} next={next} lang={lang} />
</Base>

<script>
  const chips = document.querySelectorAll<HTMLAnchorElement>('.chip');
  const panels = document.querySelectorAll<HTMLDetailsElement>('details.minor');

  function activateChips() {
    const openIds = new Set([...panels].filter((p) => p.open).map((p) => p.id));
    chips.forEach((chip) => chip.classList.toggle('active', openIds.has(chip.hash.slice(1))));
  }

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function select(id: string, scroll: boolean) {
    panels.forEach((panel) => (panel.open = panel.id === id));
    activateChips();
    if (scroll) {
      document.getElementById(id)?.scrollIntoView({ behavior: reducedMotion ? 'auto' : 'smooth', block: 'start' });
    }
  }

  chips.forEach((chip) => {
    chip.addEventListener('click', (event) => {
      event.preventDefault();
      const id = chip.hash.slice(1);
      history.replaceState(null, '', chip.hash);
      select(id, true);
    });
  });

  // 手動で <details> を開閉した場合もチップのハイライトを同期する
  panels.forEach((panel) => panel.addEventListener('toggle', activateChips));

  // ハッシュ付きで開いた場合（共有 URL など）はそのバージョンを展開する
  if (location.hash) select(location.hash.slice(1), false);
</script>

<style>
  /* ページ見出し: トップの駅表示と同じ字面をそのまま大きくする */
  .page-head {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    margin: 1.75rem 0 1.25rem;
  }
  .num {
    font-family: var(--display);
    font-stretch: 125%;
    line-height: 0.9;
    color: var(--signal);
    white-space: nowrap;
  }
  .num b {
    font-size: clamp(2.6rem, 8vw, 4rem);
    font-weight: 700;
  }
  .num i {
    font-size: 1.1rem;
    font-style: normal;
    font-weight: 500;
  }
  .page-head-text {
    min-width: 0;
  }
  .page-head-text .eyebrow {
    margin: 0 0 0.15rem;
  }
  .page-head-text h1 {
    margin: 0;
  }

  /* 路線帯: 罫線の上に各マイナーバージョンが駅として並ぶ */
  .chip-row {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    position: sticky;
    top: 0;
    z-index: 10;
    margin-top: 1.75rem;
    padding: 0.85rem 0;
    background:
      linear-gradient(var(--rail), var(--rail)) 0 50% / 100% 2px no-repeat,
      var(--ink);
    scrollbar-width: thin;
  }
  .chip {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: var(--ink-2);
    border: 1px solid var(--rail);
    border-radius: 0;
    padding: 0.3rem 0.8rem 0.3rem 0.65rem;
    color: var(--paper-dim);
    text-decoration: none;
    font-family: var(--display);
    font-stretch: 112%;
    font-size: 0.8rem;
    letter-spacing: 0.03em;
    white-space: nowrap;
    transition: border-color 0.15s, color 0.15s;
  }
  .chip::before {
    content: '';
    width: 7px;
    height: 7px;
    border: 2px solid var(--rail-lit);
    transform: rotate(45deg);
    transition: background 0.15s, border-color 0.15s, box-shadow 0.15s;
  }
  .chip:hover {
    border-color: var(--rail-lit);
    color: var(--paper);
  }
  .chip.active {
    border-color: var(--signal);
    color: var(--signal);
    font-weight: 700;
  }
  .chip.active::before {
    background: var(--signal);
    border-color: var(--signal);
    box-shadow: 0 0 0 3px var(--signal-dim);
  }

  .minor {
    background: var(--ink-2);
    clip-path: var(--chamfer);
    margin: 0.6rem 0;
  }
  /* 面取りで外側の輪郭が切られるため、フォーカス枠は内側に描く */
  .minor > summary:focus-visible {
    outline-offset: -4px;
  }
  .minor > summary {
    cursor: pointer;
    padding: 0.85rem 1rem;
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
    list-style: none;
  }
  .minor > summary::-webkit-details-marker {
    display: none;
  }
  .minor > summary::after {
    content: '';
    align-self: center;
    flex: 0 0 auto;
    width: 7px;
    height: 7px;
    border-right: 2px solid var(--paper-dim);
    border-bottom: 2px solid var(--paper-dim);
    transform: rotate(45deg) translate(-2px, -2px);
    transition: transform 0.15s;
  }
  .minor[open] > summary::after {
    transform: rotate(225deg) translate(-2px, -2px);
  }
  .minor[open] > summary {
    border-bottom: 1px solid var(--rail);
  }
  .minor > summary:hover .minor-name {
    color: var(--signal);
  }
  .minor-ver {
    color: var(--signal);
    font-family: var(--display);
    font-stretch: 112%;
    font-weight: 700;
    font-size: 0.92rem;
    letter-spacing: 0.03em;
  }
  .minor-name {
    font-weight: 700;
    transition: color 0.15s;
  }
  .count {
    /* 見出し行でもセクション見出しでも、件数は右端へ寄せる */
    margin-left: auto;
    color: var(--paper-dim);
    font-weight: 400;
    font-family: var(--display);
    font-stretch: 112%;
    font-size: 0.74rem;
    letter-spacing: 0.04em;
  }
  .minor-body {
    padding: 0.9rem 1rem 1.1rem;
  }
  .period {
    margin: 0;
    color: var(--paper-dim);
    font-family: var(--display);
    font-stretch: 112%;
    font-size: 0.76rem;
    letter-spacing: 0.03em;
  }

  /* 種別見出し: 駅ノート付きの区切り */
  .minor-body h3 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.95rem;
    margin: 1.75rem 0 0.8rem;
    padding-bottom: 0.45rem;
    border-bottom: 1px solid var(--rail);
  }
  .minor-body section:first-of-type h3 {
    margin-top: 1.1rem;
  }
  .minor-body h3::before {
    content: '';
    flex: 0 0 auto;
    width: 8px;
    height: 8px;
    background: var(--signal);
    transform: rotate(45deg);
  }
  .video-list {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  }
  .empty {
    color: var(--paper-dim);
    font-size: 0.88rem;
  }

  /*
   * 終了後向けの領域。朱＝ネタバレ注意の合図に統一し、既定で閉じておく。
   * 種別リンクの左罫と同じ色使いで「この先は進行度を超える」ことを示す。
   */
  .phase-after {
    margin-top: 2rem;
    border-left: 3px solid var(--caution);
    clip-path: var(--chamfer);
    background: var(--ink);
  }
  .phase-after > summary:focus-visible {
    outline-offset: -4px;
  }
  .phase-after summary {
    cursor: pointer;
    padding: 0.75rem 0.95rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    list-style: none;
  }
  .phase-after summary::-webkit-details-marker {
    display: none;
  }
  .phase-after summary::before {
    content: '';
    flex: 0 0 auto;
    width: 9px;
    height: 9px;
    border: 2px solid var(--caution);
    transform: rotate(45deg);
    transition: background 0.15s;
  }
  .phase-after[open] summary::before {
    background: var(--caution);
  }
  .phase-after summary::after {
    content: '';
    flex: 0 0 auto;
    width: 7px;
    height: 7px;
    border-right: 2px solid var(--caution);
    border-bottom: 2px solid var(--caution);
    transform: rotate(45deg) translate(-2px, -2px);
    transition: transform 0.15s;
  }
  .phase-after[open] summary::after {
    transform: rotate(225deg) translate(-2px, -2px);
  }
  .after-label {
    color: var(--caution);
    font-weight: 700;
    font-size: 0.9rem;
  }
  .after-body {
    padding: 0 0.95rem 0.95rem;
  }
  /* 注意領域の中は見出しノードも朱に揃える（.minor-body h3::before より詳細度を高くする） */
  .phase-after .after-body h3::before {
    background: var(--caution);
  }

  @media (max-width: 560px) {
    .page-head {
      gap: 0.85rem;
    }
  }
</style>
