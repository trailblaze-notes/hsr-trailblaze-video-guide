---
import Base from '../../layouts/Base.astro';
import MajorCard from '../MajorCard.astro';
import { loadVersions, groupByMajor, type VideoType } from '../../lib/schema';
import { STRINGS, langBase, type Lang } from '../../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = STRINGS[lang];
const versions = loadVersions(lang);
const groups = groupByMajor(versions, lang);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const root = langBase(base, lang);

// 種別ページと同じ条件で数える（excludeFromTypePages 付きは種別ページに出ない）
const countOf = (type: VideoType) =>
  versions.reduce(
    (sum, v) => sum + v.videos.filter((video) => video.type === type && !video.excludeFromTypePages).length,
    0
  );
const countText = (n: number) => (lang === 'ja' ? `${n} 件` : `${n} videos`);
const totalVideos = versions.reduce((sum, v) => sum + v.videos.length, 0);
const tally =
  lang === 'ja'
    ? `全 ${versions.length} バージョン ・ 動画 ${totalVideos} 件`
    : `${versions.length} versions ・ ${totalVideos} videos`;

const typeLinks: { type: VideoType; label: string; desc: string }[] = [
  {
    type: 'character',
    label: lang === 'ja' ? 'キャラクターPV' : 'Character Trailers',
    desc: t.typeCharacterDesc,
  },
  {
    type: 'trailblaze',
    label: lang === 'ja' ? '紀行PV・ストーリー' : 'Story & Myriad Celestia Trailers',
    desc: t.typeTrailblazeDesc,
  },
  {
    type: 'music',
    label: lang === 'ja' ? '曲（EP・MV・アニメーション）' : 'Music (EP / MV / Animation)',
    desc: t.typeMusicDesc,
  },
];
---
<Base title={t.siteTitle} lang={lang}>
  <h1>{t.homeH1}</h1>
  <p class="lead">
    {t.homeLead1}<strong>{t.homeLeadBefore}</strong>{t.homeLeadAnd}<strong>{t.homeLeadAfter}</strong>{t.homeLead2}
  </p>

  <div class="section-head">
    <h2>{t.routeHeading}</h2>
    <span class="tally">{tally}</span>
  </div>
  <ul class="route">
    {groups.map((group, i) => <MajorCard group={group} lang={lang} latest={i === groups.length - 1} />)}
  </ul>

  <div class="section-head caution-head">
    <h2>{t.typeLinksHeading}</h2>
  </div>
  <div class="type-grid">
    {
      typeLinks.map((link) => (
        <a class="type-link" href={`${root}type/${link.type}/`}>
          <span class="t-label">{link.label}</span>
          <span class="t-count">{countText(countOf(link.type))}</span>
          <span class="t-desc">{link.desc}</span>
        </a>
      ))
    }
  </div>
</Base>

<style>
  .route {
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
  }

  /* 種別ページは進行度を問わず並べるためネタバレを含む。見出しを金にして他の節と区別する */
  .caution-head h2 {
    color: var(--signal);
  }
  .type-grid {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    margin-top: 0.9rem;
  }
  .type-link {
    display: grid;
    grid-template-columns: 1fr auto;
    align-content: start;
    gap: 0.15rem 0.7rem;
    background: var(--ink-2);
    /* 破線の左罫 = 進行度の外（ネタバレを含む）。実線の節とはここで見分ける */
    border-left: 3px dashed var(--signal);
    clip-path: var(--chamfer);
    padding: 0.95rem 1.1rem;
    color: var(--paper);
    text-decoration: none;
    transition: background 0.15s;
  }
  .type-link:hover {
    background: var(--ink-3);
  }
  /* 面取りで外側の輪郭が切られるため、フォーカス枠は内側に描く */
  .type-link:focus-visible {
    outline-offset: -4px;
  }
  .t-label {
    font-weight: 700;
    font-size: 0.95rem;
    line-height: 1.45;
  }
  .t-count {
    font-family: var(--display);
    font-stretch: 112%;
    font-size: 0.76rem;
    letter-spacing: 0.04em;
    color: var(--signal);
    white-space: nowrap;
  }
  .t-desc {
    grid-column: 1 / -1;
    color: var(--paper-dim);
    font-size: 0.76rem;
  }
</style>
