---
import type { MajorGroup } from '../lib/schema';
import { STRINGS, langBase, type Lang } from '../lib/i18n';

interface Props {
  group: MajorGroup;
  lang?: Lang;
  /** 最新メジャーバージョン（路線の終点）。ノードを終端表示にする */
  latest?: boolean;
}
const { group, lang = 'ja', latest = false } = Astro.props;
const t = STRINGS[lang];
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const root = langBase(base, lang);
const first = group.versions[0];
const last = group.versions[group.versions.length - 1];
const period = last.endDate
  ? `${first.startDate} ${t.minorUntil} ${last.endDate}`
  : `${first.startDate} ${t.minorUntil} ${t.ongoing}`;
const videoCount = group.versions.reduce((sum, v) => sum + v.videos.length, 0);
const countLine =
  lang === 'ja'
    ? `全${group.versions.length}バージョン ・ 動画 ${videoCount} 件`
    : `${group.versions.length} versions ・ ${videoCount} videos`;
---
<li class:list={['stop', { terminus: latest }]}>
  <a href={`${root}v/${group.major}/`}>
    <span class="rail" aria-hidden="true"><span class="node"></span></span>
    <span class="num" aria-hidden="true"><b>{group.major}</b><i>.x</i></span>
    <span class="body">
      <span class="line-1">
        <span class="arc">{group.arc ?? `Ver.${group.major}.x`}</span>
        {latest && <span class="badge">{t.latestBadge}</span>}
      </span>
      <span class="range">Ver.{first.id} → Ver.{last.id}</span>
    </span>
    <span class="stats">
      <span class="tally">{countLine}</span>
      <span class="period">{period}</span>
    </span>
    <span class="go" aria-hidden="true">→</span>
  </a>
</li>

<style>
  .stop {
    list-style: none;
  }
  .stop a {
    /* 行の上下パディング。路線の線をこの分だけ外へ伸ばして駅間を途切れさせない */
    --row-pad: 1.1rem;
    display: grid;
    /* minmax(0, 1fr): 中身の min-content でトラックが押し広げられる（＝横スクロール）のを防ぐ */
    grid-template-columns: 2.5rem minmax(2.9rem, auto) minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 0 1.25rem;
    padding: var(--row-pad) 0.9rem var(--row-pad) 0;
    color: var(--paper);
    text-decoration: none;
    transition: background 0.15s;
  }
  .stop a:hover {
    background: var(--ink-2);
  }

  /* 路線: 各駅が自分の区間を描き、上下端だけノードで切る */
  .rail {
    position: relative;
    align-self: stretch;
    display: block;
  }
  .rail::before {
    content: '';
    position: absolute;
    left: 50%;
    top: calc(-1 * var(--row-pad));
    bottom: calc(-1 * var(--row-pad));
    width: 3px;
    margin-left: -1.5px;
    background: var(--route);
  }
  .stop:first-child .rail::before {
    top: 50%;
  }
  .stop:last-child .rail::before {
    bottom: 50%;
  }
  /* 駅は菱形。公式 UI の角のある幾何に合わせ、丸ではなく菱で刻む */
  .node {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 13px;
    height: 13px;
    margin: -6.5px 0 0 -6.5px;
    border: 2px solid var(--route-lit);
    background: var(--ink);
    transform: rotate(45deg);
    transition: background 0.15s, border-color 0.15s, box-shadow 0.15s;
  }
  .stop.terminus .node {
    border-color: var(--signal);
    background: var(--signal);
    box-shadow: 0 0 0 4px var(--signal-dim);
  }
  .stop a:hover .node {
    border-color: var(--signal);
    background: var(--signal);
  }

  /* 行先番号: 幅軸を広げた数字を標識のように大きく置く */
  .num {
    font-family: var(--display);
    font-stretch: 125%;
    line-height: 1;
    color: var(--paper);
    transition: color 0.15s;
    white-space: nowrap;
  }
  /* 主役は編名。番号は識別の目印なので、編名より一段強い程度に留める */
  .num b {
    font-size: clamp(1.6rem, 3.2vw, 2rem);
    font-weight: 700;
  }
  .num i {
    font-size: 0.78rem;
    font-style: normal;
    font-weight: 500;
    letter-spacing: 0.04em;
  }
  .stop a:hover .num,
  .stop.terminus .num {
    color: var(--signal);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }
  .line-1 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .arc {
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.4;
  }
  .badge {
    font-family: var(--display);
    font-stretch: 125%;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--signal);
    border: 1px solid var(--signal);
    border-radius: var(--radius);
    padding: 0.05rem 0.4rem;
    line-height: 1.6;
  }
  .range {
    font-family: var(--display);
    font-stretch: 112%;
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--paper-dim);
  }

  /* 時刻表のように、行の右端へ数値を揃える */
  .stats {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.1rem;
    min-width: 0;
    text-align: right;
    white-space: nowrap;
  }
  .tally {
    font-size: 0.78rem;
    color: var(--paper);
  }
  .period {
    font-family: var(--display);
    font-stretch: 112%;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--paper-dim);
  }

  .go {
    color: var(--paper-dim);
    font-size: 1.1rem;
    transition: color 0.15s, transform 0.15s;
  }
  .stop a:hover .go {
    color: var(--signal);
    transform: translateX(3px);
  }

  @media (max-width: 760px) {
    .stop a {
      --row-pad: 1rem;
      grid-template-columns: 2.25rem auto minmax(0, 1fr);
      gap: 0.15rem 1rem;
      padding: var(--row-pad) 0.5rem var(--row-pad) 0;
    }
    .stats {
      grid-column: 3;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.1rem 0.6rem;
      white-space: normal;
      text-align: left;
    }
    .go {
      display: none;
    }
  }
</style>
